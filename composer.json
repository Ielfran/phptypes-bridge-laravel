{
    "name": "ielfran/phptypes-bridge-laravel",
    "description": "Laravel integration for PHPTypeS/bridge — Artisan commands, auto-discovery, and route scanning",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "typescript", "codegen", "api", "dto", "bridge"],
    "require": {
        "php": "^8.1",
        "ielfran/phptypes-bridge": "^0.1",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support":   "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing":   "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console":   "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "orchestra/testbench": "^8.0|^9.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "PHPTypeS\\BridgeLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPTypeS\\BridgeLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PHPTypeS\\BridgeLaravel\\BridgeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}